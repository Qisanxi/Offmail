# ============ Gmail credentials ============
# Generate app password: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ============ IMAP / SMTP settings ============
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ============ Ollama ============
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b

# ============ App settings ============
# Poll Gmail every N seconds
POLL_INTERVAL_SECONDS=120
# Only fetch emails from last N days
FETCH_WINDOW_DAYS=7
# SQLite DB path (relative to backend/)
DATABASE_URL=sqlite:///./offmail.db
# CORS — comma separated origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ Drafting ============
DRAFT_TONE=friendly_professional
DRAFT_MAX_WORDS=80
SIGNATURE=— sent via Offmail (local-first)

# ============ Queue ============
# Retry failed sends every N seconds
QUEUE_RETRY_SECONDS=60
